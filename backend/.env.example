# copy this file to .env and edit
PORT=3000

# MariaDB (XAMPP default: user root, empty password)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=ecoride_db

# REQUIRED: a long random text (32+ characters). The server will NOT start with this example value.
# Make one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-text
JWT_EXPIRES_IN=7d

# 1 = real time. Set 30 to see the battery move 30x faster in a demo (same as AppStore.timeScale)
BATTERY_TIME_SCALE=1

# true  = a student can confirm their own QR top-up (there is no real payment gateway yet, same as the app today)
# false = only an admin can confirm top-ups
ALLOW_SELF_CONFIRM_TOPUP=true

# Flutter web runs on a random localhost port, so * is fine while developing
CORS_ORIGIN=*
